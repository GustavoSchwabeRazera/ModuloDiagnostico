# Configuração de exemplo do ExportAI

# Diagnóstico e persistência

# Inteligência complementar
EXPORTAI_DIAGNOSTICO_IA_PROVEDOR=DESATIVADO
EXPORTAI_DIAGNOSTICO_IA_MODELO=

# Ollama
EXPORTAI_DIAGNOSTICO_OLLAMA_HOST=http://127.0.0.1:11434
EXPORTAI_DIAGNOSTICO_OLLAMA_TIMEOUT=90
EXPORTAI_DIAGNOSTICO_OLLAMA_TEMPERATURE=0

# Busca controlada
EXPORTAI_DIAGNOSTICO_BUSCA_PROVEDOR=DESATIVADO
EXPORTAI_DIAGNOSTICO_SEARXNG_URL=
EXPORTAI_DIAGNOSTICO_BUSCA_LIMITE_RESULTADOS=5
EXPORTAI_DIAGNOSTICO_PESQUISA_AUTOMATICA_HABILITADA=false

# Download seguro
EXPORTAI_DIAGNOSTICO_DOWNLOAD_TIMEOUT=15
EXPORTAI_DIAGNOSTICO_DOWNLOAD_MAX_BYTES=3000000

# Testes experimentais
EXPORTAI_TESTE_INTEGRACAO_REAL=false

EXPORTAI_DATABASE_URL=postgresql+psycopg://usuario:senha@host:5432/exportai

EXPORTAI_DATABASE_REQUIRE_POSTGRES_PRODUCTION=true

EXPORTAI_SESSAO_RETENCAO_HORAS=24

EXPORTAI_DIAGNOSTICO_IA_FALLBACK=

GEMINI_API_KEY=

EXPORTAI_GEMINI_MODELO=

GROQ_API_KEY=

EXPORTAI_GROQ_MODELO=

EXPORTAI_GROQ_STRUCTURED_STRICT=false

EXPORTAI_AMBIENTE=DESENVOLVIMENTO

EXPORTAI_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://exportai-brazil.netlify.app,https://export-recommend-wiz.lovable.app

EXPORTAI_HANDOFF_DESTINOS=https://DOMINIO-DO-DIAGNOSTICO.lovable.app

EXPORTAI_HANDOFF_SECRET=

EXPORTAI_HANDOFF_TTL_SEGUNDOS=120
